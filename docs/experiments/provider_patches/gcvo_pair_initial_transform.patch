+static Eigen::Matrix4f load_init_matrix(const std::string& path) {
+  if (path.empty()) return Eigen::Matrix4f::Identity();
+  std::ifstream stream(path);
+  if (!stream) throw std::runtime_error("Cannot open init matrix: " + path);
+  Eigen::Matrix4f matrix;
+  for (int r = 0; r < 4; ++r)
+    for (int c = 0; c < 4; ++c)
+      if (!(stream >> matrix(r, c)))
+        throw std::runtime_error("Init matrix must contain 16 floats: " + path);
+  return matrix;
+}
